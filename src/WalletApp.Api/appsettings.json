{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "UseUtcTimestamp": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ ",
        "JsonWriterOptions": { "Indented": false }
      }
    }
  },
  "RateLimiting": {
    "Enabled": true,
    "ReadPermitLimit": 120,
    "WritePermitLimit": 30,
    "WindowSeconds": 60
  },
  "Telemetry": {
    "Enabled": true,
    "ServiceName": "wallet-api",
    "Exporter": "None",
    "OtlpEndpoint": ""
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "WalletDb": "Server=localhost;Database=WalletApp;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "WalletSeed": {
    "WalletId": 123,
    "OwnerName": "Demo Wallet",
    "InitialBalance": 1000.00,
    "Currency": "ZAR"
  },
  "Withdrawal": {
    "MaxConcurrencyRetries": 25,
    "MaxIdempotencyKeyLength": 100,
    "HistoryDefaultPageSize": 20,
    "HistoryMaxPageSize": 100
  },
  "Outbox": {
    "Enabled": true,
    "PollIntervalMs": 1000,
    "BatchSize": 50
  },
  "EventBus": {
    "Provider": "RabbitMq"
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "Exchange": "wallet.events",
    "RoutingKey": "wallet.withdrawal.completed",
    "Queue": "wallet.withdrawals"
  }
}
